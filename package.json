{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "server": "bun run server/index.ts",
    "backend:url": "bun run ./scripts/set-backend-url.ts",
    "contracts:abi": "bun run ./scripts/export-registry-abi.ts",
    "test": "bun test tests/auth.test.ts tests/format.test.ts tests/history.test.ts tests/payments.test.ts tests/uniswap.test.ts tests/split.test.ts tests/swapApi.test.ts tests/activity.test.ts tests/executeApi.test.ts tests/rpc.test.ts tests/scanPlan.test.ts tests/tipGate.test.ts tests/coverage.test.tsx tests/readPaths.test.ts tests/nav.test.ts tests/send.test.ts tests/bridge.test.ts tests/swapAmount.test.ts tests/swapState.test.ts tests/api.test.ts tests/deployment.test.ts tests/arcTokens.test.ts tests/chainHistory.test.ts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "test:render": "bun test --preload ./tests/setup-dom.ts tests/render.test.tsx tests/rpcBatch.test.ts tests/walletModal.test.tsx",
    "perf:report": "bun run ./scripts/perf-report.ts",
    "test:smoke": "bun run tests/api.smoke.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "^5.62.7",
    "@types/qrcode": "^1.5.6",
    "@web3icons/react": "^4.0.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
